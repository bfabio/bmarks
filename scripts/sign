#!/bin/sh

set -eu

channel=${1:-unlisted}

if [ "$channel" != unlisted ] && [ "$channel" != listed ]; then
  printf '%s\n' "usage: $0 [unlisted|listed]" >&2
  exit 2
fi

if [ -z "${WEB_EXT_API_KEY:-}" ] || [ -z "${WEB_EXT_API_SECRET:-}" ]; then
  printf '%s\n' \
    'Set WEB_EXT_API_KEY and WEB_EXT_API_SECRET before signing.' >&2
  exit 1
fi

exec ./node_modules/.bin/web-ext sign \
  --api-key "$WEB_EXT_API_KEY" \
  --api-secret "$WEB_EXT_API_SECRET" \
  --channel "$channel" \
  --source-dir . \
  --artifacts-dir web-ext-artifacts
